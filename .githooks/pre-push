#!/usr/bin/env bash
# Local pre-push gate: ruff + pytest (mirrors .github/workflows/pr-checks.yml).
# Install per clone:  git config core.hooksPath .githooks
# Bypass (emergencies only):  git push --no-verify
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Skip when the push carries no Python changes vs the upstream (or main).
UPSTREAM=""
if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name "@{u}")
elif git rev-parse --verify origin/main >/dev/null 2>&1; then
  UPSTREAM="origin/main"
fi
if [ -n "$UPSTREAM" ]; then
  CHANGED=$(git diff --name-only "$UPSTREAM"...HEAD 2>/dev/null || echo "")
  if [ -n "$CHANGED" ] && ! echo "$CHANGED" | grep -qE '\.py$|pyproject\.toml$'; then
    echo "[pre-push] no Python changes; skipping ruff/pytest"
    exit 0
  fi
fi

# Prefer the project venv if one is present.
PY="python"
if [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"
fi

echo "[pre-push] ruff check"
"$PY" -m ruff check .
echo "[pre-push] pytest"
"$PY" -m pytest -q
echo "[pre-push] checks passed"
