# Void POS web. Copy to .env.local only to change where the API is.
#
# The till calls /api on the page's own origin and this server proxies it to the API.
# VOIDPOS_API_URL is where the proxy sends it (default http://localhost:8000; in Docker the
# image is built with http://api:8000).
# VOIDPOS_API_URL=http://localhost:8000
#
# Or skip the proxy and point the till straight at an API (the API must then list this
# page's origin in VOIDPOS_CORS_ORIGINS). Fixed at build time.
# NEXT_PUBLIC_API_BASE=http://192.168.1.20:8000
