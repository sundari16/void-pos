# Void POS web — copy to .env.local and fill in the IDs printed by the seed script.
#
#   python scripts/seed_dev.py               (from the repo root; prints the block below)

# Base URL of the FastAPI backend (void_pos.main:app).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# The location this till rings orders up against.
NEXT_PUBLIC_LOCATION_ID=

# This POS device (owns a private order-number range).
NEXT_PUBLIC_DEVICE_ID=

# First order number to mint on this device; must sit inside the device's range.
# The seed device is provisioned with the range 1000–1999.
NEXT_PUBLIC_ORDER_NUMBER_START=1000
