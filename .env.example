# Copy to .env and fill in. .env is git-ignored; keep it on the venue machine only.

# --- Docker install (docker compose) ----------------------------------------------
# Database password. Letters and digits only: it is placed inside a connection URL.
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# Venue admin token for setup, menu edits and export: 24+ characters.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VOIDPOS_ADMIN_TOKEN=

# Optional: the kitchen printer's address on the venue network (raw ESC/POS, port 9100).
# VOIDPOS_KITCHEN_PRINTER_HOST=192.168.1.50
# VOIDPOS_KITCHEN_PRINTER_PORT=9100
# A font with the glyphs for non-Latin tickets, placed in ./fonts:
# VOIDPOS_KITCHEN_FONT_PATH=/fonts/NotoSansTamil-Regular.ttf

# Customer receipt printer at the counter (optional). Without one, the till shows the
# receipt on screen to print another way. 42 columns for 80 mm paper, 32 for 58 mm.
# VOIDPOS_RECEIPT_PRINTER_HOST=192.168.1.51
# VOIDPOS_RECEIPT_PRINTER_PORT=9100
# VOIDPOS_RECEIPT_PRINTER_COLUMNS=42

# Optional: card payments on the till through Stripe. SANDBOX keys only (sk_test_/pk_test_);
# the server refuses live keys. The same keys pay for online (storefront) card orders.
# VOIDPOS_STRIPE_SECRET_KEY=sk_test_...
# VOIDPOS_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Online ordering, loyalty, marketing -----------------------------------------
# The customer storefront (/order/<location id>, served by the web app; the public
# /online/* API). On by default; set to false to turn the storefront off.
# VOIDPOS_ONLINE_ORDERING_ENABLED=true

# Loyalty: off by default (no points earned or redeemable). When on, customers earn
# whole points per whole dollar and each point is worth this many cents at checkout.
# VOIDPOS_LOYALTY_ENABLED=true
# VOIDPOS_LOYALTY_EARN_POINTS_PER_DOLLAR=1
# VOIDPOS_LOYALTY_REDEEM_CENTS_PER_POINT=1

# Marketing campaigns (void-pos send-campaign, or POST /admin/locations/{id}/campaigns).
# Default "log" just records what it would send. Point a channel at a real provider and
# fill its credentials to actually send. Only opted-in customers are ever contacted.
# VOIDPOS_MARKETING_SMS_SENDER=twilio
# VOIDPOS_TWILIO_ACCOUNT_SID=
# VOIDPOS_TWILIO_AUTH_TOKEN=
# VOIDPOS_TWILIO_FROM_NUMBER=+61...
# VOIDPOS_MARKETING_EMAIL_SENDER=sendgrid
# VOIDPOS_SENDGRID_API_KEY=
# VOIDPOS_SENDGRID_FROM_EMAIL=hello@yourvenue.com.au

# Optional: bring the menu over from Square (void-pos import-square). A Square access
# token; it's only used to read the item library.
# VOIDPOS_SQUARE_ACCESS_TOKEN=

# Optional: nightly backups into ./backups (local time, kept this many days).
# BACKUP_AT=03:00
# BACKUP_KEEP_DAYS=14
# TZ=Australia/Brisbane

# Optional: host ports.
# WEB_PORT=3000
# API_PORT=8000

# --- Running the API directly (development) --------------------------------------
# VOIDPOS_DATABASE_URL=postgresql+psycopg://localhost/void_pos
